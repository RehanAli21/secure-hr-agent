# Settings for Docker Compose (compose.yaml). Copy this file to .env and fill it in.
# (This is only for Docker. Running the services by hand uses backend/.env and agent/.env.)
#
# Make each secret with:   python -c "import secrets; print(secrets.token_hex(32))"
# (hex = only letters and digits, so they are safe inside a database URL)

# The password of "postgres", the OWNER of the tables (only the one-time setup uses it).
POSTGRES_PASSWORD=
# The password of "gatekeeper_app", the API's own database user with limited rights.
APP_DB_PASSWORD=
# Signs the login tokens.
JWT_SECRET_KEY=

# "yes" = add the demo company (550 employees, password Password123!) to an empty database.
# Set it to "no" for real use.
SEED_DEMO_DATA=yes

# How much text the model reads at once (see agent/.env.example).
OLLAMA_CONTEXT=8192
