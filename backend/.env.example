# Copy this file to .env and fill in your own values.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gatekeeper_hr

# A long random secret used to sign login tokens. Make your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=PUT_A_LONG_RANDOM_SECRET_HERE

# A SEPARATE database for the automated tests (create it like the main one). The tests empty it all the time!
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gatekeeper_hr_test
