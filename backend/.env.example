# Copy this file to .env and fill in your own values.
#
# Two database users (see create_app_user.py, which creates gatekeeper_app for you):
#   DATABASE_URL        the API's own user: it may only read and write the rows it needs
#   OWNER_DATABASE_URL  the owner of the tables (here postgres): migrations, seed.py, create_user.py...
# Make the gatekeeper_app password up yourself, for example with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# 127.0.0.1, not "localhost": on Windows "localhost" waits ~2 seconds for IPv6 first.
DATABASE_URL=postgresql://gatekeeper_app:APP_PASSWORD@127.0.0.1:5432/gatekeeper_hr
OWNER_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/gatekeeper_hr

# A long random secret used to sign login tokens. Make your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=PUT_A_LONG_RANDOM_SECRET_HERE

# A SEPARATE database for the automated tests (create it like the main one). The tests empty it all the time!
# The same two users, on the test database (use the same gatekeeper_app password as above:
# a database user belongs to the whole PostgreSQL server, not to one database).
TEST_DATABASE_URL=postgresql://gatekeeper_app:APP_PASSWORD@127.0.0.1:5432/gatekeeper_hr_test
TEST_OWNER_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/gatekeeper_hr_test
