# Copy this file to .env and fill in your own values.

# Where the CRUD API (the backend) runs. The agent service talks to it over HTTP only.
# The agent service has NO database password: it can never touch the data directly.
CRUD_API_URL=http://localhost:8000

# The AI model runs locally in Ollama (https://ollama.com). Download the model first:
#   ollama pull qwen3:4b-instruct
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct

# How much text (in tokens, about 3/4 of a word each) the model reads at once. This setting wins
# over the "context length" slider in the Ollama app. Bigger needs more GPU memory, and whatever
# doesn't fit in the GPU runs on the CPU, which is several times slower. For qwen3:4b-instruct:
#   4096  -> about 3.5 GB   (good for a 4 GB GPU)
#   8192  -> about 4.2 GB   (6 GB GPU)
#   16384 -> about 5 GB     (8 GB GPU)
#   32768 -> about 7.5 GB   (12 GB GPU)
# Check where it runs with:  ollama ps   (PROCESSOR should say 100% GPU)
OLLAMA_CONTEXT=4096
